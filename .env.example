# Pick an existing local Codex thread. Find its ID with `codex resume`.
CODEX_THREAD_ID=
# Absolute working directory for the Codex process.
CODEX_CWD=/absolute/path/to/your/project
# Use an absolute binary path here if Codex is not on PATH.
CODEX_BINARY=codex
# What a send does while Codex is working: steer or queue.
CODEX_ACTIVE_MESSAGE_MODE=steer
# Add your Tailscale HTTPS origin, with no trailing slash.
CODEX_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional JSON array. The default starts a private local app-server process.
CODEX_SERVER_ARGS='["app-server","--listen","stdio://"]'
