{
  "name": "codex-pocket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:agents": "env -u NO_COLOR playwright test --config playwright.agents.config.ts",
    "desktop": "tsx scripts/desktop.ts",
    "test:server": "tsx scripts/live-server.ts",
    "test:e2e:queue": "env -u NO_COLOR CODEX_TEST_ACTIVE_MODE=queue playwright test",
    "test:e2e:questions": "env -u NO_COLOR CODEX_TEST_PLAN_MODE=1 playwright test",
    "test:e2e:schedules": "env -u NO_COLOR CODEX_TEST_SCHEDULES=1 playwright test",
    "test:e2e:images": "env -u NO_COLOR CODEX_TEST_IMAGES=1 playwright test",
    "test:e2e:activity": "env -u NO_COLOR CODEX_TEST_ACTIVITY=1 playwright test",
    "test:recovery": "tsx scripts/recovery-check.ts",
    "test:instructions": "tsx scripts/instructions-check.ts",
    "test:harnesses": "tsx scripts/harness-check.ts",
    "test:delegation": "tsx scripts/delegation-check.ts",
    "setup": "tsx scripts/configure.ts",
    "service:install": "tsx scripts/install-service.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@next/env": "^16.4.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rrule": "^2.8.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-doctor": "0.9.18",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "78.0.0",
    "jiti": "2.7.0",
    "prettier": "3.9.9",
    "prettier-plugin-toml": "^2.0.6",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
