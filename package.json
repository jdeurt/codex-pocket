{
  "name": "codex-pocket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project public/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "tsx scripts/test-flows.ts",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:agents": "env -u NO_COLOR playwright test --project='agents-*'",
    "desktop": "tsx scripts/desktop.ts",
    "test:e2e:queue": "env -u NO_COLOR CODEX_TEST_ACTIVE_MODE=queue playwright test --project=live",
    "test:e2e:questions": "env -u NO_COLOR CODEX_TEST_PLAN_MODE=1 playwright test --project=live",
    "test:e2e:schedules": "env -u NO_COLOR CODEX_TEST_SCHEDULES=1 playwright test --project=live",
    "test:e2e:images": "env -u NO_COLOR CODEX_TEST_IMAGES=1 playwright test --project=live",
    "test:e2e:activity": "env -u NO_COLOR CODEX_TEST_ACTIVITY=1 playwright test --project=live",
    "test:recovery": "tsx scripts/recovery-check.ts",
    "test:instructions": "tsx scripts/instructions-check.ts",
    "test:harnesses": "tsx scripts/harness-check.ts",
    "test:delegation": "tsx scripts/delegation-check.ts",
    "setup": "tsx scripts/configure.ts",
    "test:server:live": "env POCKET_LIVE_TESTS=1 tsx scripts/live-server.ts",
    "test:e2e:live": "env -u NO_COLOR POCKET_LIVE_TESTS=1 playwright test --project=live",
    "test:e2e:uploads": "env -u NO_COLOR playwright test --project='uploads-*'",
    "test:e2e:copy": "env -u NO_COLOR playwright test tests/browser/workflows/transcript.spec.ts --grep='copy action'",
    "test:e2e:virtualization": "env -u NO_COLOR playwright test tests/browser/workflows/transcript.spec.ts --grep='saved native history'",
    "test:e2e:restart": "env -u NO_COLOR playwright test --config=playwright.realtime.config.ts tests/browser/workflows/voice-recovery.spec.ts",
    "usage": "tsx scripts/usage.ts",
    "review:duplicates": "jscpd",
    "review:dead-code": "jscpd --dead-code --dead-code-categories all --min-confidence 0 --include-tests --include-entry-exports",
    "test:simulators": "tsx scripts/test-flows.ts --simulators",
    "test:simulators:native": "tsx scripts/calibrate-simulators.ts",
    "simulators:extract": "tsx scripts/extract-simulator-contracts.ts",
    "test:e2e:updates": "env -u NO_COLOR playwright test --config=playwright.update.config.ts",
    "test:e2e:realtime": "env -u NO_COLOR playwright test --config=playwright.realtime.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@next/env": "^16.4.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@tobilu/qmd": "2.8.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "ical.js": "^2.2.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pino": "^10.4.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rrule": "^2.8.1",
    "sharp": "^0.35.5",
    "try": "1.0.3",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "ajv": "^8.17.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.3.15",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-doctor": "0.9.18",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "78.0.0",
    "jiti": "2.7.0",
    "jscpd": "^5.4.1",
    "prettier": "3.9.9",
    "prettier-plugin-toml": "3.0.2",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
